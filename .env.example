# Discord (Anabella)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_GENERAL=
DISCORD_CHANNEL_CHAT=
DISCORD_CHANNEL_PAYMENTS=
DISCORD_CHANNEL_EVENTS=
DISCORD_CHANNEL_JOURNAL=

# Email 1
ACCOUNT_PRIMARY_ALIAS=primary
ACCOUNT_PRIMARY_EMAIL=
ACCOUNT_PRIMARY_IMAP_HOST=imap.gmail.com
ACCOUNT_PRIMARY_IMAP_PASSWORD=
ACCOUNT_PRIMARY_SYNC_LABELS=Payment,DevBG,Udemy
ACCOUNT_PRIMARY_ICS_URL=

# Email 2
ACCOUNT_SECONDARY_ALIAS=secondary
ACCOUNT_SECONDARY_EMAIL=
ACCOUNT_SECONDARY_IMAP_HOST=imap.gmail.com
ACCOUNT_SECONDARY_IMAP_PASSWORD=
ACCOUNT_SECONDARY_SYNC_LABELS=Payment,DevBG
ACCOUNT_SECONDARY_ICS_URL=

# Fernet Key — generate once:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Database — set in .env only (never commit real values)
# Generate a local dev password, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=anabella
POSTGRES_PASSWORD=
POSTGRES_DB=anabella
# Bot on host → localhost; full docker compose app service → change host to `db`
DATABASE_URL=postgresql+asyncpg://anabella:YOUR_POSTGRES_PASSWORD@localhost:5432/anabella

# Sync intervals (seconds)
IMAP_SYNC_INTERVAL=300
IMAP_BACKFILL_DAYS=365
ICS_SYNC_INTERVAL=900
ICS_HORIZON_DAYS_PAST=30
ICS_HORIZON_DAYS_FUTURE=365

# Journal
JOURNAL_HOUR=20
JOURNAL_MINUTE=0
JOURNAL_TIMEZONE=Europe/Sofia

# Memory / QA
MEMORY_SIMILARITY_THRESHOLD=0.35
CITATION_MAX_RETRIES=1
LLM_EXTRACTION_ENABLED=true

# LLM (fill before B4 / C1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
